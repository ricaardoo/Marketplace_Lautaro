# ---- Application ----
ENVIRONMENT=development
DEBUG=0

# ---- Database (PostgreSQL) ----
# Local (no docker): point to a running Postgres, or use SQLite for quick dev:
#   DATABASE_URL=sqlite+aiosqlite:///./.data/marketplace.db
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace
AUTO_CREATE_TABLES=1

# ---- Security ----
SECRET_KEY=change-me-in-production
COOKIE_SECURE=0
SESSION_TTL_DAYS=7
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=300

# ---- Cache / rate limiting ----
# Leave empty to use the in-memory fallback (single process only).
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

# ---- Object storage (optional) ----
# Leave S3_BUCKET empty to store uploads on local disk under MEDIA_DIR.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
MEDIA_DIR=.data/media
MEDIA_URL_PREFIX=/media

# ---- CORS (only needed if the frontend is served from another origin) ----
CORS_ORIGINS=
CSP_IMG_EXTRA=
